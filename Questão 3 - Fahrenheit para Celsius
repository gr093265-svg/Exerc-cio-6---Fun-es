#include <stdio.h>

float fahrenheitParaCelsius(float f) {
    float c;
    c = (f - 32.0) * (5.0 / 9.0);
    return c;
}

int main() {
    float f;

    printf("Digite a temperatura em Fahrenheit: ");
    scanf("%f", &f);

    printf("Temperatura em Celsius: %.2f\n", fahrenheitParaCelsius(f));

    return 0;
}
